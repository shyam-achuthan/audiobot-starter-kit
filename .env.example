# Copy to .env with `make env` (generates secrets and detects LIVEKIT_NODE_IP).
# Values marked __GENERATE__ are filled automatically.

# ---------- LiveKit ----------
LIVEKIT_API_KEY=__GENERATE__
LIVEKIT_API_SECRET=__GENERATE__
# IP that browsers AND containers can both reach (your Mac's LAN IP in local dev).
# `make ip` refreshes it when your network changes.
LIVEKIT_NODE_IP=127.0.0.1
# URL browsers use to reach LiveKit
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# ---------- Postgres (app DB + twenty/chatwoot/langfuse/litellm DBs) ----------
POSTGRES_USER=audiobots
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=audiobots

# ---------- S3-compatible storage (RustFS) ----------
S3_ACCESS_KEY=__GENERATE__
S3_SECRET_KEY=__GENERATE__
S3_BUCKET_RECORDINGS=recordings
S3_BUCKET_LANGFUSE=langfuse

# ---------- LiteLLM gateway ----------
LITELLM_MASTER_KEY=__GENERATE__

# ---------- Internal API auth ----------
# Shared secret the voice agent (and server-side admin pages) use to call the API.
AGENT_API_TOKEN=__GENERATE__

# ---------- Provider keys (fill in what you use) ----------
# Speech (STT + TTS) — needed from Phase 1
SARVAM_API_KEY=
# LLM default (Gemini via Google AI Studio)
GEMINI_API_KEY=
# Optional fallbacks / embedding providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Google Vertex AI (path inside the litellm container, mount via infra/litellm/secrets/)
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=asia-south1
# Key file goes in infra/litellm/secrets/vertex-sa.json (path is set in docker-compose.yml)
# AWS Bedrock
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=ap-south-1

# ---------- Agent ----------
# Business name the voice agents introduce themselves with.
COMPANY_NAME=AudioBots Demo

# ---------- Voice pipeline (optional overrides) ----------
# STT_MODEL=saaras:v4          # saaras:v3 | saaras:v4
# STT_MODE=transcribe          # transcribe | codemix | translit | verbatim
# TTS_MODEL=bulbul:v3          # bulbul:v3 | bulbul:v4-flash (lower latency)
# TTS_SPEAKER=priya            # any bulbul speaker, e.g. kavya, rahul, amit
# LLM_MODEL=agent-fast         # LiteLLM alias: agent-fast | agent-smart
# ENDPOINTING_MIN_DELAY=0.3    # seconds of silence before a turn can end
# ENDPOINTING_MAX_DELAY=1.2    # cap on waiting when the turn detector thinks the caller is mid-sentence
# PREEMPTIVE_GENERATION=true

# ---------- Network ----------
# Optional HTTP proxy for traffic to cloud providers (Sarvam, Gemini…), e.g. a corporate proxy.
# If containers can't reach the internet directly (seen with some VPN apps on macOS),
# Docker Desktop's built-in proxy works: OUTBOUND_PROXY=http://http.docker.internal:3128
OUTBOUND_PROXY=

# ---------- Admin ----------
# The dashboard (/admin) needs an email + password sign-in. On first start, if no accounts exist,
# these create the owner account (password: 10+ characters, letters plus numbers or symbols).
# Leave empty to create the owner on the /login page instead. Change the password in the
# dashboard afterwards; these values are only used while no accounts exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# How long a sign-in lasts.
ADMIN_SESSION_HOURS=168

# ---------- App ----------
# Comma-separated origins allowed to call the API (website embedding the widget)
CORS_ORIGINS=http://localhost:3000
